# ── Supabase (required for global shared leaderboard) ─────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
#
# VITE_ prefix is required — these are safe to expose client-side (anon key only)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Without these vars the app still works — leaderboard falls back to localStorage.
